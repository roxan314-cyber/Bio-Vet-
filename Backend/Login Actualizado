<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema Médico - Login y Ficha</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --bg-color: #f8fafc;
            --card-bg: #ffffff;
            --text-color: #1e293b;
            --border-color: #cbd5e1;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 500px;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        }

        h2 {
            margin-top: 0;
            color: var(--primary);
            text-align: center;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            font-size: 14px;
        }

        input, textarea, select {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 14px;
        }

        textarea {
            resize: vertical;
            height: 100px;
        }

        button {
            width: 100%;
            padding: 10px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            margin-top: 10px;
        }

        button:hover {
            background-color: var(--primary-dark);
        }

        .switch-text {
            text-align: center;
            margin-top: 15px;
            font-size: 14px;
        }

        .switch-text a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .switch-text a:hover {
            text-decoration: underline;
        }

        .hidden {
            display: none !important;
        }

        .alert {
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 15px;
            font-size: 14px;
            text-align: center;
        }

        .alert-error {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .alert-success {
            background-color: #dcfce7;
            color: #166534;
        }

        .user-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #e2e8f0;
            padding: 10px 15px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .btn-logout {
            background-color: #ef4444;
            width: auto;
            padding: 5px 10px;
            margin: 0;
            font-size: 12px;
        }
        .btn-logout:hover {
            background-color: #dc2626;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- SECCIÓN DE MENSAJES -->
        <div id="alertBox" class="hidden alert"></div>

        <!-- VISTA 1: LOGIN -->
        <div id="loginView">
            <h2>Iniciar Sesión</h2>
            <form id="loginForm">
                <div class="form-group">
                    <label for="loginEmail">Correo Electrónico</label>
                    <input type="email" id="loginEmail" required>
                </div>
                <div class="form-group">
                    <label for="loginPassword">Contraseña</label>
                    <input type="password" id="loginPassword" required>
                </div>
                <button type="submit">Entrar</button>
            </form>
            <div class="switch-text">
                ¿No tienes una cuenta? <a onclick="showView('registerView')">Regístrate aquí</a>
            </div>
        </div>

        <!-- VISTA 2: REGISTRO DE USUARIO -->
        <div id="registerView" class="hidden">
            <h2>Registro de Usuario</h2>
            <form id="registerForm">
                <div class="form-group">
                    <label for="regName">Nombre Completo</label>
                    <input type="text" id="regName" required>
                </div>
                <div class="form-group">
                    <label for="regEmail">Correo Electrónico</label>
                    <input type="email" id="regEmail" required>
                </div>
                <div class="form-group">
                    <label for="regPassword">Contraseña</label>
                    <input type="password" id="regPassword" required>
                </div>
                <button type="submit">Registrarse</button>
            </form>
            <div class="switch-text">
                ¿Ya tienes una cuenta? <a onclick="showView('loginView')">Inicia sesión</a>
            </div>
        </div>

        <!-- VISTA 3: REGISTRO DE FICHA MÉDICA (Panel Principal tras loguearse) -->
        <div id="medicalView" class="hidden">
            <div class="user-info">
                <span>Bienvenido, <strong id="userNameDisplay"></strong></span>
                <button class="btn-logout" onclick="logout()">Cerrar Sesión</button>
            </div>
            <h2>Registro de Ficha Médica</h2>
            <form id="medicalForm">
                <div class="form-group">
                    <label for="medAge">Edad</label>
                    <input type="number" id="medAge" min="0" max="120" required>
                </div>
                <div class="form-group">
                    <label for="medBlood">Tipo de Sangre</label>
                    <select id="medBlood" required>
                        <option value="">Seleccione...</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="medConditions">Enfermedades crónicas o antecedentes</label>
                    <textarea id="medConditions" placeholder="Ej. Hipertensión, diabetes, ninguna..."></textarea>
                </div>
                <div class="form-group">
                    <label for="medAllergies">Alergias</label>
                    <textarea id="medAllergies" placeholder="Ej. Penicilina, polen, mariscos..."></textarea>
                </div>
                <button type="submit">Enviar a Base de Datos Médica</button>
            </form>
        </div>
    </div>

    <script>
        // Referencias a los elementos del DOM
        const loginView = document.getElementById('loginView');
        const registerView = document.getElementById('registerView');
        const medicalView = document.getElementById('medicalView');
        const alertBox = document.getElementById('alertBox');
        const userNameDisplay = document.getElementById('userNameDisplay');

        // Formularios
        const loginForm = document.getElementById('loginForm');
        const registerForm = document.getElementById('registerForm');
        const medicalForm = document.getElementById('medicalForm');

        // Función para cambiar entre vistas
        function showView(viewId) {
            loginView.classList.add('hidden');
            registerView.classList.add('hidden');
            medicalView.classList.add('hidden');
            hideAlert();

            document.getElementById(viewId).classList.remove('hidden');
        }

        // Mostrar alertas en pantalla
        function showAlert(message, type = 'error') {
            alertBox.textContent = message;
            alertBox.className = `alert alert-${type}`;
            alertBox.classList.remove('hidden');
        }

        function hideAlert() {
            alertBox.classList.add('hidden');
        }

        // --- MANEJO DE USUARIOS (Simulación Base de Datos Local) ---
        
        // Registrar usuario
        registerForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = document.getElementById('regName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const password = document.getElementById('regPassword').value;

            // Obtener usuarios existentes o inicializar arreglo
            let users = JSON.parse(localStorage.getItem('db_users')) || [];

            // Verificar si el correo ya está registrado
            const userExists = users.some(user => user.email === email);
            if (userExists) {
                showAlert('Este correo ya está registrado.');
                return;
            }

            // Guardar nuevo usuario
            users.push({ name, email, password });
            localStorage.setItem('db_users', JSON.stringify(users));

            showAlert('¡Registro exitoso! Ahora puedes iniciar sesión.', 'success');
            registerForm.reset();
            setTimeout(() => showView('loginView'), 1500);
        });

        // Iniciar sesión
        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value;

            let users = JSON.parse(localStorage.getItem('db_users')) || [];

            // Buscar usuario coincidente
            const validUser = users.find(user => user.email === email && user.password === password);

            if (validUser) {
                // Guardar sesión activa
                localStorage.setItem('session_active', JSON.stringify(validUser));
                loginForm.reset();
                initSession();
            } else {
                showAlert('Correo o contraseña incorrectos.');
            }
        });

        // Verificar si ya hay una sesión activa al cargar la página
        function checkSession() {
            const activeUser = JSON.parse(localStorage.getItem('session_active'));
            if (activeUser) {
                userNameDisplay.textContent = activeUser.name;
                showView('medicalView');
            } else {
                showView('loginView');
            }
        }

        function initSession() {
            const activeUser = JSON.parse(localStorage.getItem('session_active'));
            if (activeUser) {
                userNameDisplay.textContent = activeUser.name;
                showView('medicalView');
            }
        }

        // Cerrar sesión
        function logout() {
            localStorage.removeItem('session_active');
            showView('loginView');
        }

        // --- MANEJO DE LA FICHA MÉDICA ---
        medicalForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const activeUser = JSON.parse(localStorage.getItem('session_active'));

            if (!activeUser) {
                showAlert('Sesión expirada. Por favor, vuelve a iniciar sesión.');
                logout();
                return;
            }

            const medicalData = {
                userEmail: activeUser.email,
                userName: activeUser.name,
                age: document.getElementById('medAge').value,
                bloodType: document.getElementById('medBlood').value,
                conditions: document.getElementById('medConditions').value,
                allergies: document.getElementById('medAllergies').value,
                date: new Date().toLocaleString()
            };

            // Obtener base de datos médica existente en localStorage
            let medicalDatabase = JSON.parse(localStorage.getItem('db_medical_records')) || [];

            // Guardar la nueva ficha médica (simulando envío al servidor/BD)
            medicalDatabase.push(medicalData);
            localStorage.setItem('db_medical_records', JSON.stringify(medicalDatabase));

            showAlert('¡Ficha médica enviada y guardada en la base de datos con éxito!', 'success');
            medicalForm.reset();

            // Opcional: Imprimir en consola para verificar los datos guardados como si fuera el panel de un médico
            console.log("Base de datos médica actual:", medicalDatabase);
        });

        // Ejecutar verificación de sesión inicial al cargar la página
        window.onload = checkSession;
    </script>
</body>
</html>