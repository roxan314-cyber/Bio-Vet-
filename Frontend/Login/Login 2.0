document.addEventListener('DOMContentLoaded', () => {
    const loginForm = document.getElementById('loginForm');
    const errorMessage = document.getElementById('errorMessage');
    const submitBtn = document.getElementById('submitBtn');

    // Validación de seguridad
    if (!loginForm || !submitBtn) return;

    loginForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        // Limpiar errores 
        if (errorMessage) {
            errorMessage.textContent = '';
            errorMessage.style.display = 'none';
        }

        const usernameInput = document.getElementById('username');
        const passwordInput = document.getElementById('password');
        
        const username = usernameInput ? usernameInput.value.trim() : '';
        const password = passwordInput ? passwordInput.value.trim() : '';

        // Validación en el lado del cliente
        if (!username || !password) {
            if (errorMessage) {
                errorMessage.textContent = 'Por favor, completa todos los campos obligatorios.';
                errorMessage.style.display = 'block';
            }
            return;
        }

        // Estado de carga
        submitBtn.innerText = 'Iniciando sesión...';
        submitBtn.disabled = true;

        try {
            const response = await fetch('/api/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ username, password })
            });

            // Intentar parsear la respuesta de forma segura
            let data;
            try {
                data = await response.json();
            } catch (jsonError) {
                throw new Error('La respuesta del servidor no tiene un formato válido.');
            }

            if (!response.ok) {
                // Soporta tanto 'message' como 'mensaje' devueltos por PHP
                throw new Error(data.message || data.mensaje || 'Credenciales incorrectas o error en el servidor.');
            }

            // Éxito: Guardar el token de sesión
            if (data.token) {
                localStorage.setItem('auth_token', data.token);
                if (data.usuario) {
                    localStorage.setItem('user_data', JSON.stringify(data.usuario));
                }
            }

            // Limpiar y redirigir
            loginForm.reset();
            window.location.href = '/dashboard.html';

        } catch (error) {
            if (errorMessage) {
                errorMessage.textContent = error.message || 'No se pudo conectar con el servidor.';
                errorMessage.style.display = 'block';
            }
        } finally {
            // Restaurar el botón siempre
            submitBtn.innerText = 'Iniciar Sesión';
            submitBtn.disabled = false;
        }
    });
});